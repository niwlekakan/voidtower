{
  "openapi": "3.1.0",
  "info": {
    "title": "VoidTower API",
    "version": "1"
  },
  "paths": {
    "/api/resources/{resource_id}/actions/{action}/plan": {
      "post": {
        "operationId": "planCanonicalAction",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiVersion"
          },
          {
            "$ref": "#/components/parameters/ResourceId"
          },
          {
            "$ref": "#/components/parameters/Action"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CanonicalActionRequest"
        },
        "responses": {
          "200": {
            "description": "Immutable operation plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanSuccessEnvelopeV1"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          },
          "406": {
            "$ref": "#/components/responses/VersionError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "422": {
            "$ref": "#/components/responses/ApiError"
          },
          "500": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/resources/{resource_id}/actions/{action}": {
      "post": {
        "operationId": "submitCanonicalAction",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiVersion"
          },
          {
            "$ref": "#/components/parameters/ResourceId"
          },
          {
            "$ref": "#/components/parameters/Action"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CanonicalActionRequest"
        },
        "responses": {
          "202": {
            "description": "Durable job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSuccessEnvelopeV1"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          },
          "406": {
            "$ref": "#/components/responses/VersionError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "422": {
            "$ref": "#/components/responses/ApiError"
          },
          "500": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ApiVersion": {
        "name": "x-voidtower-api-version",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "const": "1"
        }
      },
      "ResourceId": {
        "name": "resource_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "Action": {
        "name": "action",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "requestBodies": {
      "CanonicalActionRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CanonicalActionRequestV1"
            }
          }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "Bounded API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorEnvelopeV1"
            }
          }
        }
      },
      "VersionError": {
        "description": "Unsupported API version",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/VersionErrorEnvelopeV1"
            }
          }
        }
      }
    },
    "schemas": {
      "ActionInputV1": {
        "type": "object",
        "description": "Action-specific object validated by the registered action schema. Nested JSON values are limited to eight levels, 64 properties/items per level, 128-character keys, 4 KiB strings, and a 64 KiB canonical encoding by the backend.",
        "maxProperties": 64,
        "propertyNames": {
          "maxLength": 128
        },
        "additionalProperties": {
          "$ref": "#/components/schemas/BoundedActionValueV1"
        }
      },
      "BoundedActionValueV1": {
        "description": "Nested action JSON value; recursive depth and canonical byte limits are enforced by the backend.",
        "x-voidtower-max-canonical-bytes": 65536,
        "x-voidtower-max-depth": 8,
        "x-voidtower-max-string-chars": 4096,
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 4096
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/BoundedActionValueV1"
            }
          },
          {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "maxLength": 128
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/BoundedActionValueV1"
            }
          }
        ]
      },
      "CanonicalActionRequestV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "$ref": "#/components/schemas/ActionInputV1"
          }
        }
      },
      "ResourceRefV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "display_name",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PlanChangeV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "maxLength": 2048
          }
        }
      },
      "PlannedStepV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "retry_class",
          "recovery_class"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "retry_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "recovery_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "OperationPlanV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "title",
          "risk",
          "changes",
          "preview",
          "external_fingerprint",
          "steps"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "risk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "changes": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/PlanChangeV1"
            }
          },
          "preview": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16384
          },
          "external_fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/PlannedStepV1"
            }
          }
        }
      },
      "PolicyPreviewV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome",
          "reason"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "allow",
              "require_approval",
              "deny"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          }
        }
      },
      "PlanViewV1": {
        "type": "object",
        "description": "The server and client enforce cross-field invariants: action selects the exact input/result schema identities, and resource/action must match the enclosing success envelope.",
        "x-voidtower-cross-field": [
          {
            "equals": [
              "input_schema_id",
              "action + .input.v1"
            ]
          },
          {
            "equals": [
              "result_schema_id",
              "action + .result.v1"
            ]
          }
        ],
        "additionalProperties": false,
        "required": [
          "action",
          "resource",
          "input_schema_id",
          "result_schema_id",
          "operation",
          "policy"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceRefV1"
          },
          "input_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}\\.input\\.v1$",
            "description": "Must equal the plan action followed by .input.v1."
          },
          "result_schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}\\.result\\.v1$",
            "description": "Must equal the plan action followed by .result.v1."
          },
          "operation": {
            "$ref": "#/components/schemas/OperationPlanV1"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyPreviewV1"
          }
        }
      },
      "PlanSuccessEnvelopeV1": {
        "type": "object",
        "description": "The nested plan action and resource must match the enclosing action and resource_id fields.",
        "x-voidtower-cross-field": [
          {
            "equals": [
              "plan.action",
              "action"
            ]
          },
          {
            "equals": [
              "plan.resource.id",
              "resource_id"
            ]
          }
        ],
        "additionalProperties": false,
        "required": [
          "schema_version",
          "resource_id",
          "action",
          "plan"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "plan": {
            "$ref": "#/components/schemas/PlanViewV1"
          }
        }
      },
      "ActorRefV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_type",
          "id",
          "source"
        ],
        "properties": {
          "actor_type": {
            "type": "string",
            "enum": [
              "human",
              "api_token",
              "automation",
              "plugin",
              "node",
              "ai",
              "system"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      },
      "OperationErrorV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable",
          "job_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "retryable": {
            "type": "boolean"
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        }
      },
      "JobStateV1": {
        "type": "string",
        "enum": [
          "awaiting_approval",
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled",
          "needs_attention",
          "rejected",
          "expired"
        ]
      },
      "BoundedActionResultValueV1": {
        "description": "Recursive JSON result value; backend validation uses a 4160-character string bound and a 64 KiB canonical encoding bound.",
        "x-voidtower-max-canonical-bytes": 65536,
        "x-voidtower-max-depth": 8,
        "x-voidtower-max-string-chars": 4160,
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "maxLength": 4160
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/BoundedActionResultValueV1"
            }
          },
          {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "type": "string",
              "maxLength": 128
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/BoundedActionResultValueV1"
            }
          }
        ]
      },
      "JobViewV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "resource",
          "actor",
          "ingress",
          "state",
          "progress_current",
          "progress_total",
          "progress_message",
          "plan",
          "approval_id",
          "result",
          "error",
          "submitted_at",
          "started_at",
          "finished_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceRefV1"
          },
          "actor": {
            "$ref": "#/components/schemas/ActorRefV1"
          },
          "ingress": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "state": {
            "$ref": "#/components/schemas/JobStateV1"
          },
          "progress_current": {
            "type": "integer",
            "minimum": 0
          },
          "progress_total": {
            "type": "integer",
            "minimum": 0
          },
          "progress_message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "plan": {
            "$ref": "#/components/schemas/OperationPlanV1"
          },
          "approval_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BoundedActionResultValueV1"
              }
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/OperationErrorV1"
              }
            ]
          },
          "submitted_at": {
            "type": "integer"
          },
          "started_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "updated_at": {
            "type": "integer"
          }
        }
      },
      "JobListSuccessEnvelopeV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "jobs"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "jobs": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/components/schemas/JobViewV1"
            }
          }
        }
      },
      "JobSuccessEnvelopeV1": {
        "type": "object",
        "description": "The nested job action and resource must match the enclosing action and resource_id fields.",
        "x-voidtower-cross-field": [
          {
            "equals": [
              "job.action",
              "action"
            ]
          },
          {
            "equals": [
              "job.resource.id",
              "resource_id"
            ]
          }
        ],
        "additionalProperties": false,
        "required": [
          "schema_version",
          "resource_id",
          "action",
          "job"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "job": {
            "$ref": "#/components/schemas/JobViewV1"
          }
        }
      },
      "ApiErrorEnvelopeV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "job_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "VersionErrorEnvelopeV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "supported_versions"
            ],
            "properties": {
              "code": {
                "const": "unsupported_api_version"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "supported_versions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    }
  }
}
