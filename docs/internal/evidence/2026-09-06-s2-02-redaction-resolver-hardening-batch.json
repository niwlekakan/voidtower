      "continue_on_failure": false,
      "declared_label": "unit-verified"
    },
    {
      "id": "diff-check",
      "cwd": ".",
      "argv": ["git", "diff", "--check"],
      "timeout_seconds": 120,
      "continue_on_failure": false,
