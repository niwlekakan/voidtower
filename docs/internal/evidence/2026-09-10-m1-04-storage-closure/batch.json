{
  "run_id": "M1-04-storage-mutation-closure-2026-09-10",
  "steps": [
    {
      "id": "source-truth",
      "cwd": ".",
      "argv": ["python", "scripts/repo_truth.py", "--repo", ".", "--json", "--check"],
      "timeout_seconds": 120,
      "continue_on_failure": false,
      "declared_label": "implemented"
    },
    {
      "id": "focused-storage-router-tests",
      "cwd": ".",
      "argv": ["docker", "run", "--rm", "-v", ".:/workspace", "-w", "/workspace/backend", "rust:latest", "cargo", "test", "api::storage::tests", "--all-features", "--", "--nocapture"],
      "timeout_seconds": 900,
      "continue_on_failure": false,
      "declared_label": "integration-verified"
    },
    {
      "id": "backend-full-tests",
      "cwd": ".",
      "argv": ["docker", "run", "--rm", "-v", ".:/workspace", "-w", "/workspace/backend", "rust:latest", "cargo", "test", "--all-targets", "--all-features"],
      "timeout_seconds": 900,
      "continue_on_failure": false,
      "declared_label": "integration-verified"
    },
    {
      "id": "backend-clippy",
      "cwd": ".",
      "argv": ["docker", "run", "--rm", "-v", ".:/workspace", "-w", "/workspace/backend", "rust:latest", "cargo", "clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
      "timeout_seconds": 900,
      "continue_on_failure": true,
      "declared_label": "unit-verified"
    },
    {
      "id": "focused-rustfmt",
      "cwd": ".",
      "argv": ["docker", "run", "--rm", "-v", ".:/workspace", "-w", "/workspace/backend", "rust:latest", "rustfmt", "--edition", "2021", "--config", "skip_children=true", "--check", "src/api/storage.rs"],
      "timeout_seconds": 120,
      "continue_on_failure": true,
      "declared_label": "unit-verified"
