{
  "schema_version": 1,
  "external_gates": [
    {
      "id": "golden-path-runtime",
      "reason": "Requires the host Docker/restic boundary and is qualified by the dedicated release runtime job.",
      "required": true,
      "evidence_file": "release-external-golden-path-runtime.json",
      "workflow_job": "golden-path-runtime",
      "command": ["cargo", "run", "--example", "golden_path"],
      "cwd": "backend"
    },
    {
      "id": "secret-history-scan",
      "reason": "Requires the repository-host security scanner; tracked-path hygiene is enforced by repository-hygiene.",
      "required": true,
      "evidence_file": "release-external-secret-history-scan.json",
      "workflow_job": "secret-history-scan",
      "command": ["observed-ci-step"],
      "cwd": "."
    }
  ],
  "gates": [
    {
      "id": "repository-truth-tests",
      "description": "Deterministic repository truth fixture tests",
      "subsystems": ["governance"],
      "required": true,
      "cwd": ".",
      "argv": ["python3", "scripts/test_repo_truth.py", "-v"],
      "timeout_seconds": 120,
      "evidence_limit": "unit-verified"
    },
    {
      "id": "repository-truth-check",
      "description": "Credential-safe source inventory",
      "subsystems": ["governance"],
      "required": true,
      "cwd": ".",
